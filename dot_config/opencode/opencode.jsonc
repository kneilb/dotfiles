{
    "$schema": "https://opencode.ai/config.json",
    "enabled_providers": ["azure"],
    "lsp": true,
    "permission": {
        "edit": "allow",
        "bash": {
            "*": "ask",
            "ls": "allow",
            "go test *": "allow",
            "go vet *": "allow",
            "mkdir *": "allow",
            "git add *": "allow",
            "git show *": "allow",
            "git log *": "allow",
            "git status *": "allow",
            "git commit *": "allow",
            "git rev-parse *": "allow",
            "git diff *": "allow",
            "wc *": "allow"
        }
    },
    "provider": {
        "azure": {
            "npm": "@ai-sdk/azure",
            "models": {
                "gpt-5.4-nano": {
                    "name": "gpt-5.4-nano",
                    "cost": {
                        "input": 0.20,
                        "output": 1.25,
                        "cache_read": 0.02,
                        "cache_write": 0
                    },
                    "options": {
                        "reasoningEffort": "high"
                    }
                },
                "gpt-5.4-mini": {
                    "name": "gpt-5.4-mini",
                    "cost": {
                        "input": 0.75,
                        "output": 4.50,
                        "cache_read": 0.08,
                        "cache_write": 0
                    },
                    "options": {
                        "reasoningEffort": "high"
                    }
                },
                "gpt-5.6-luna": {
                    "name": "gpt-5.6-luna",
                    "cost": {
                        "input": 0.20,
                        "output": 1.20,
                        "cache_read": 0.02,
                        "cache_write": 0.25,
                        "context_over_200k": {
                            "input": 0.40,
                            "output": 1.80,
                            "cache_read": 0.04,
                            "cache_write": 0.50
                        }
                    },
                    "options": {
                        "reasoningEffort": "high",
                        "setCacheKey": true
                    },
                    "variants": {
                        "none": {
                            "reasoningEffort": "none"
                        },
                        "low": {
                            "reasoningEffort": "low"
                        },
                        "medium": {
                            "reasoningEffort": "medium"
                        },
                        "high": {
                            "reasoningEffort": "high"
                        },
                        "xhigh": {
                            "reasoningEffort": "xhigh"
                        },
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                }
            }
        }
    },
    "small_model": "azure/gpt-5.4-nano",
    "model": "azure/gpt-5.6-luna"
}